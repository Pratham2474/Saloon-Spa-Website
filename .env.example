# Copy this file to ".env" and edit. Never commit ".env".
# If SECRET_KEY is empty, a random one is created once and saved in ".secret_key".
SECRET_KEY=
# Needed once, to create the first admin at /setup. If empty, a random key is printed in the console.
SETUP_KEY=
# 1 = auto-reload + error pages (development only)
FLASK_DEBUG=1

# Email (optional). Leave MAIL_SERVER empty and the site still works.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
